	<connectionStrings>
		<add name="ucsdbEntities" connectionString="metadata=res://*/Database.ucsdb.csdl|res://*/Database.ucsdb.ssdl|res://*/Database.ucsdb.msl;provider=MySql.Data.MySqlClient;provider connection string=&quot;server=localhost;user id=root;password=root;CharSet=utf8mb4;persistsecurityinfo=True;database=ucsdb&quot;" providerName="System.Data.EntityClient" />
